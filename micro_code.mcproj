    "instructions": [
      {
        "opcode": 0,
        "mnemonic": "NOP",
        "format": "R",
        "description": "空操作"
      },
      {
        "opcode": 16,
        "mnemonic": "MOV",
        "format": "R",
        "description": "Rw ← Ra"
      },
      {
        "opcode": 17,
        "mnemonic": "ILD",
        "format": "R",
        "description": "Rw ← M[Rb]（间接读）"
      },
      {
        "opcode": 18,
        "mnemonic": "IST",
        "format": "R",
        "description": "M[Rb] ← Ra（间接写）"
      },
      {
        "opcode": 19,
        "mnemonic": "LDR",
        "format": "I",
        "description": "Rw ← M[addr]（绝对读）"
      },
      {
        "opcode": 20,
        "mnemonic": "STR",
        "format": "I",
        "description": "M[addr] ← Ra（绝对写）"
      },
      {
        "opcode": 21,
        "mnemonic": "LDI",
        "format": "I",
        "description": "Rw ← imm32（加载立即数）"
      },
      {
        "opcode": 22,
        "mnemonic": "LDA",
        "format": "I",
        "description": "Rw ← addr（加载绝对地址）"
      },
      {
        "opcode": 23,
        "mnemonic": "LDO",
        "format": "R",
        "description": "Rw ← M[Ra + Rb]（基址+偏移读）"
      },
      {
        "opcode": 32,
        "mnemonic": "ADD",
        "format": "R",
        "description": "Rw ← Ra + Rb · ALUMODE 0000"
      },
      {
        "opcode": 33,
        "mnemonic": "SUB",
        "format": "R",
        "description": "Rw ← Ra - Rb · ALUMODE 0001"
      },
      {
        "opcode": 34,
        "mnemonic": "INC",
        "format": "R",
        "description": "Rw ← Ra + 1 · ALUMODE 1100"
      },
      {
        "opcode": 35,
        "mnemonic": "DEC",
        "format": "R",
        "description": "Rw ← Ra - 1 · ALUMODE 1101"
      },
      {
        "opcode": 36,
        "mnemonic": "MUL",
        "format": "R",
        "description": "Rw ← Ra * Rb（低32位）· ALUMODE 0010"
      },
      {
        "opcode": 37,
        "mnemonic": "DIV",
        "format": "R",
        "description": "Rw ← Ra / Rb（商）· ALUMODE 0011"
      },
      {
        "opcode": 38,
        "mnemonic": "REM",
        "format": "R",
        "description": "Rw ← Ra % Rb（余数）· ALUMODE 1110"
      },
      {
        "opcode": 39,
        "mnemonic": "SFT",
        "format": "R",
        "description": "Rw ← Ra 移位（Rb低5位）· ALUMODE 0100"
      },
      {
        "opcode": 40,
        "mnemonic": "AND",
        "format": "R",
        "description": "Rw ← Ra & Rb · ALUMODE 0101"
      },
      {
        "opcode": 41,
        "mnemonic": "NAND",
        "format": "R",
        "description": "Rw ← ~(Ra & Rb) · ALUMODE 0110"
      },
      {
        "opcode": 42,
        "mnemonic": "OR",
        "format": "R",
        "description": "Rw ← Ra | Rb · ALUMODE 0111"
      },
      {
        "opcode": 43,
        "mnemonic": "NOR",
        "format": "R",
        "description": "Rw ← ~(Ra | Rb) · ALUMODE 1000"
      },
      {
        "opcode": 44,
        "mnemonic": "XOR",
        "format": "R",
        "description": "Rw ← Ra ^ Rb · ALUMODE 1001"
      },
      {
        "opcode": 45,
        "mnemonic": "XNOR",
        "format": "R",
        "description": "Rw ← ~(Ra ^ Rb) · ALUMODE 1010"
      },
      {
        "opcode": 46,
        "mnemonic": "NOT",
        "format": "R",
        "description": "Rw ← ~Ra · ALUMODE 1011"
      },
      {
        "opcode": 47,
        "mnemonic": "CMP",
        "format": "R",
        "description": "Ra - Rb，只更新C、Z · ALUMODE 0001"
      },
      {
        "opcode": 48,
        "mnemonic": "JMP",
        "format": "I",
        "description": "PC ← addr（无条件）"
      },
      {
        "opcode": 49,
        "mnemonic": "JCC",
        "format": "I",
        "description": "若条件满足则 PC ← addr"
      },
      {
        "opcode": 50,
        "mnemonic": "JPR",
        "format": "R",
        "description": "PC ← Ra（间接）"
      },
      {
        "opcode": 51,
        "mnemonic": "JRC",
        "format": "R",
        "description": "若条件满足则 PC ← Ra"
      },
      {
        "opcode": 52,
        "mnemonic": "CALL",
        "format": "I",
        "description": "压栈返回地址，PC ← addr"
      },
      {
        "opcode": 53,
        "mnemonic": "CAC",
        "format": "I",
        "description": "若条件满足则 CALL"
      },
      {
        "opcode": 54,
        "mnemonic": "RET",
        "format": "R",
        "description": "弹栈返回地址，PC ← M[SP]"
      },
      {
        "opcode": 55,
        "mnemonic": "INT",
        "format": "I",
        "description": "软中断：压栈PC+FLAGS，PC ← addr"
      },
      {
        "opcode": 56,
        "mnemonic": "CINT",
        "format": "I",
        "description": "若条件满足则 INT"
      },
      {
        "opcode": 57,
        "mnemonic": "IRET",
        "format": "R",
        "description": "中断返回：恢复FLAGS和PC"
      },
      {
        "opcode": 58,
        "mnemonic": "EI",
        "format": "R",
        "description": "开中断（IE ← 1）"
      },
      {
        "opcode": 59,
        "mnemonic": "DI",
        "format": "R",
        "description": "关中断（IE ← 0）"
      },
      {
        "opcode": 64,
        "mnemonic": "PUSH",
        "format": "R",
        "description": "SP ← SP+1，M[SP] ← Ra"
      },
      {
        "opcode": 65,
        "mnemonic": "POP",
        "format": "R",
        "description": "Rw ← M[SP]，SP ← SP-1"
      },
      {
        "opcode": 66,
        "mnemonic": "LSP",
        "format": "R",
        "description": "SP ← Ra（设置栈指针）"
      },
      {
        "opcode": 240,
        "mnemonic": "HALT",
        "format": "R",
        "description": "停机"
      }
    ],
