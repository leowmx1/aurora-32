    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>20</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>指令集
0x00–0x0F：NOP 和测试草稿区
操作码	助记符	格式	功能
0x00	NOP	R	空操作
0x01–0x0F	(测试草稿)	–	保留用于测试新指令，当前执行 NOP
0x10–0x1F：寄存器和内存控制
操作码	助记符	格式	功能
0x10	MOV	R	Rw ← Ra
0x11	ILD	R	Rw ← M[Rb]（Rb 的内容作为地址读内存）
0x12	IST	R	M[Rb] ← Ra（Rb 的内容作为地址写内存）
0x13	LDR	双字	Rw ← M[addr]（addr 为紧接着的 32 位地址）
0x14	STR	双字	M[addr] ← Ra（addr 为紧接着的 32 位地址）
0x15	LDI	双字	Rw ← imm32（第二字为 32 位立即数）
0x16–0x1F	(保留)	–	可扩展更多访存模式
0x20–0x2F：逻辑运算区
操作码	助记符	格式	功能	ALUMODE
0x20	ADD	R	Rw ← Ra + Rb，更新 C, Z	0000
0x21	SUB	R	Rw ← Ra - Rb，更新 C, Z	0001
0x22	INC	R	Rw ← Ra + 1，不更新标志	1100
0x23	DEC	R	Rw ← Ra - 1，不更新标志	1101
0x24	MUL	R	Rw ← Ra * Rb（低 32 位），更新 C, Z	0010
0x25	DIV	R	Rw ← Ra / Rb（商），更新 C, Z	0011
0x26	REM	R	Rw ← Ra % Rb（余数），更新 Z	1110
0x27	SFT	R	Rw ← Ra 移位（移位量 Rb 低 5 位），更新 C, Z	0100
0x28	AND	R	Rw ← Ra &amp; Rb，更新 Z	0101
0x29	NAND	R	Rw ← ~(Ra &amp; Rb)，更新 Z	0110
0x2A	OR	R	Rw ← Ra | Rb，更新 Z	0111
0x2B	NOR	R	Rw ← ~(Ra | Rb)，更新 Z	1000
0x2C	XOR	R	Rw ← Ra ^ Rb，更新 Z	1001
0x2D	XNOR	R	Rw ← ~(Ra ^ Rb)，更新 Z	1010
0x2E	NOT	R	Rw ← ~Ra，更新 Z	1011
0x2F	CMP	R	Ra - Rb，只更新 C, Z，不写回	0001
0x30–0x3F：程序控制区
操作码	助记符	格式	功能
0x30	JMP	双字	PC ← addr（无条件跳转）
0x31	JPR	R	PC ← Ra（间接跳转）
0x32	JC	双字	若 C=1 则 PC ← addr
0x33	JZ	双字	若 Z=1 则 PC ← addr
0x34	JNC	双字	若 C=0 则 PC ← addr
0x35	JNZ	双字	若 Z=0 则 PC ← addr
0x36	CALL	双字	M[Ra] ← PC，Ra ← Ra + 1，PC ← addr
0x37	RET	R	Ra ← Ra - 1，PC ← M[Ra]
0x38–0x3F	(保留)	–	可扩展条件调用等
0xF0–0xFF：运行管理区
操作码	助记符	格式	功能
0xF0	HALT	R	停机（需外部停时钟）
0xF1–0xFF	(保留)	–	可扩展中断、电源管理等</string>
        </entry>
      </elementAttributes>
      <pos x="1820" y="-680"/>
    </visualElement>
