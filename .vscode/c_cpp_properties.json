{
  "configurations": [
    {
      "name": "Aurora-32",
      "compilerPath": "${workspaceFolder}/build-tools/bin/clang.exe",
      "compilerArgs": ["-target", "aurora"],
      "includePath": [
        "${workspaceFolder}/build-tools/lib/clang/24/include",
        "${workspaceFolder}/user-programs/include",
        "${workspaceFolder}/**"
      ],
      "defines": ["__aurora__"],
      "cStandard": "c11",
      "intelliSenseMode": "windows-clang-x86"
    }
  ],
  "version": 4
}
